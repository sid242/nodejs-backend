{
  "name": "node-scalable-foundation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "dev:docker": "docker compose --profile full up --build",
    "start": "node --env-file=.env dist/server.js",
    "start:worker": "node --env-file=.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "node --import tsx src/scripts/run-tests.ts",
    "test:coverage": "node --import tsx src/scripts/run-tests.ts --experimental-test-coverage",
    "test:unit": "tsx --env-file-if-exists=.env --test --test-force-exit test/*.test.ts",
    "test:integration": "tsx --env-file-if-exists=.env --test --test-force-exit test/integration/**/*.test.ts",
    "openapi:export": "tsx src/scripts/export-openapi.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:migrate:all": "tsx --env-file=.env src/db/migrate-all.ts",
    "db:studio": "drizzle-kit studio",
    "db:bootstrap": "tsx --env-file=.env src/db/seed/bootstrap.ts",
    "db:seed": "tsx --env-file=.env src/db/seed/demo.ts",
    "db:seed:demo": "tsx --env-file=.env src/db/seed/demo.ts",
    "db:clean": "tsx --env-file=.env src/scripts/clean-db.ts",
    "db:reset": "tsx --env-file=.env src/scripts/reset-db.ts",
    "db:fresh": "npm run db:reset && npm run db:migrate && npm run db:seed",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@bull-board/api": "^5.23.0",
    "@bull-board/express": "^5.23.0",
    "@node-saml/node-saml": "^5.2.0",
    "@prometheus-io/client": "^0.16.1",
    "@sentry/node": "^11.16.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.1",
    "otpauth": "^9.6.0",
    "pino": "^10.4.0",
    "pino-http": "^10.3.0",
    "postgres": "^3.4.9",
    "rate-limit-redis": "^6.0.2",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": "prettier --write"
  }
}
