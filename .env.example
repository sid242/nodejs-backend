NODE_ENV=development
APP_NAME=api
PORT=3000
LOG_LEVEL=debug
TRUST_PROXY=1
CORS_ORIGINS=http://localhost:5173

# Postgres (Docker container & application connection)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@localhost:5432/app
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IDLE_TIMEOUT_SECONDS=30
DB_MAX_LIFETIME_SECONDS=1800

# Redis (Docker container & application connection)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Production: provide independent endpoints. Defaults to REDIS_URL for simple local development.
CACHE_REDIS_URL=
QUEUE_REDIS_URL=
SOCKET_REDIS_URL=

JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-string-of-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800

# AWS. In production leave the keys EMPTY and use an IAM role (ECS task role).
AWS_REGION=ap-south-1
S3_BUCKET=app-uploads-local
S3_MAX_UPLOAD_MB=10
S3_DELETE_CONCURRENCY=10
SES_FROM_EMAIL=
# --- local MinIO only (remove for real AWS) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Nginx local reverse proxy (full profile)
NGINX_PORT=8080

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

WORKER_CONCURRENCY=10
EMAIL_WORKER_CONCURRENCY=10
FILE_WORKER_CONCURRENCY=5
MAINTENANCE_WORKER_CONCURRENCY=1
MAINTENANCE_BATCH_SIZE=500
CACHE_LOCK_TTL_SECONDS=10
HTTP_REQUEST_TIMEOUT_MS=30000
SOCKET_CONNECTIONS_PER_MINUTE=30
SOCKET_EVENTS_PER_SECOND=30

# Queue dashboard at /admin/queues (disabled if password is empty)
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=
